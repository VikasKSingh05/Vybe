# VYBE - Environment Variables
# Copy to .env.local for development; set the same keys in your hosting
# dashboard (Vercel) for production. See DEPLOY.md for the full runbook.

# Public origin of the deployed app. Used for metadataBase, Open Graph URLs,
# robots.txt and sitemap.xml. No trailing slash.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Comma-separated LAN origins allowed to load the dev server cross-origin
# (e.g. testing from your phone). Dev-only; ignored in production builds.
# ALLOWED_DEV_ORIGINS=192.168.0.102

# Base URL of the JioSaavn API service (deployed separately, e.g. on Render).
# Server-side only — the frontend never talks to it directly.
JIOSAAVN_API_URL=https://your-jiosaavn-api.example

# Redis connection for shared state (VYBE LIVE radio + VYBE Jam rooms),
# in ioredis format. REQUIRED in production: without it, state is per-process
# memory and will split across serverless instances/cold starts.
# REDIS_URL=rediss://default:<password>@<host>:<port>
